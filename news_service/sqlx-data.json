    "query": "\n        SELECT \n            nbr.post_uri,\n            u.handle as \"reposted_by_handle?\"\n        FROM\n            news_bsky_reference as nbr\n            JOIN news_bsky_user as u ON u.did = nbr.ref_post_uri\n        WHERE\n            nbr.ref_kind = 'repost'\n            AND nbr.post_uri = ANY($1)\n        "
