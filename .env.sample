POSTGRES_USER=climate_news
POSTGRES_DB=climate_news
POSTGRES_PASSWORD=climate_news
DATABASE_URL="postgres://climate_news:climate_news@db:5432/climate_news"
GRAPHQL_API_URL="http://news_api:8000/graphql"
PUBLIC_DOMAIN=climatenews.app
OPENAI_API_KEY=

# Slack
POST_CRON_WEBHOOK_URL=
MAIN_CRON_WEBHOOK_URL=

# Bluesky
BLUESKY_HANDLE=climatenews-app.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# Optional backup settings (used by devops/cron/postgres-maintenance.sh)
# S3_BACKUP_BUCKET=
# S3_BACKUP_PREFIX=postgres
# BACKUP_RETENTION_DAYS=14
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# Optional infra alert settings (used by runner scripts)
# ALERT_WEBHOOK_URL=

# Optional testing knobs
# Limit number of Bluesky users processed per cron run (unset for full run)
# BSKY_MAX_USERS_PER_RUN=10